#!/usr/bin/env bash
# Wrapper: runs cargo for the desktop crate inside the shared org
# rust-builder image. The image (`ghcr.io/niceguyit/rust-builder-glibc`)
# bakes in Rust 1.94 + rustfmt + clippy and every GTK/WebKit/Soup/SSL system
# library the Tao+Wry desktop crate needs, so no apt step is required at run
# time and the local check matches the CI build environment one-for-one.
# Image tag must stay aligned with `ci-build/Dockerfile.desktop-linux`.
#
# Cargo registry and target volumes are shared with dev/cargo so a build
# triggered by either wrapper picks up the other's compiled deps. As in
# dev/cargo, the container starts as root just long enough to chown the
# named volumes to the host user, then drops to the host uid/gid via
# setpriv before invoking cargo, so files cargo writes into the /work bind
# mount (eg. Cargo.lock) land with the right ownership on the host.
#
# When invoked with `cargo run` from a graphical session the wrapper also
# forwards the X11 / Wayland display, the LETS_CHAT_SERVER_URL env, and
# switches to host networking so the GUI window renders and so localhost
# dev servers are reachable from inside the container.
set -euo pipefail

EXTRA_ARGS=()

# Compute build metadata on the host (the rust:slim container has no git).
# build.rs reads these env vars first and falls back to "unknown" otherwise.
GIT_HASH=$(git rev-parse --short=12 HEAD 2>/dev/null || echo unknown)
GIT_VERSION=$(git describe --tags --always --dirty 2>/dev/null || echo "$GIT_HASH")
BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EXTRA_ARGS+=(
    -e "GIT_HASH=$GIT_HASH"
    -e "GIT_VERSION=$GIT_VERSION"
    -e "BUILD_DATE=$BUILD_DATE"
)

# Forward LETS_CHAT_SERVER_URL so the desktop binary opens the right window.
if [ -n "${LETS_CHAT_SERVER_URL:-}" ]; then
    EXTRA_ARGS+=(-e "LETS_CHAT_SERVER_URL=${LETS_CHAT_SERVER_URL}")
fi

# Display forwarding for `cargo run`. Detected via DISPLAY / WAYLAND_DISPLAY.
# Host networking is also enabled so the binary can reach localhost dev
# servers and so X11 over TCP works without extra plumbing.
if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
    EXTRA_ARGS+=(--network=host --ipc=host)
    if [ -n "${DISPLAY:-}" ]; then
        EXTRA_ARGS+=(-e "DISPLAY=${DISPLAY}")
        if [ -d /tmp/.X11-unix ]; then
            EXTRA_ARGS+=(-v /tmp/.X11-unix:/tmp/.X11-unix:rw)
        fi
        if [ -n "${XAUTHORITY:-}" ] && [ -f "${XAUTHORITY}" ]; then
            EXTRA_ARGS+=(-v "${XAUTHORITY}:${XAUTHORITY}:ro" -e "XAUTHORITY=${XAUTHORITY}")
        fi
    fi
    if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
        EXTRA_ARGS+=(
            -e "WAYLAND_DISPLAY=${WAYLAND_DISPLAY}"
            -e "XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}"
            -v "${XDG_RUNTIME_DIR}:${XDG_RUNTIME_DIR}:rw"
        )
    fi
fi

HOST_UID=$(id -u)
HOST_GID=$(id -g)
EXTRA_ARGS+=(
    -e "HOST_UID=$HOST_UID"
    -e "HOST_GID=$HOST_GID"
)

docker run --rm --init \
    -v "$PWD:/work" \
    -w /work \
    -v lets-chat-rewrite-cargo-registry:/usr/local/cargo/registry \
    -v lets-chat-rewrite-cargo-git:/usr/local/cargo/git \
    -v lets-chat-rewrite-target:/cargo-target \
    -e CARGO_HOME=/usr/local/cargo \
    -e CARGO_TARGET_DIR=/cargo-target \
    "${EXTRA_ARGS[@]}" \
    ghcr.io/niceguyit/rust-builder-glibc:v1.0.1-rust1.94-trixie \
    bash -c '
        set -euo pipefail
        for d in /usr/local/cargo/registry /usr/local/cargo/git /cargo-target; do
            if [ "$(stat -c %u "$d")" != "$HOST_UID" ]; then
                chown -R "$HOST_UID:$HOST_GID" "$d"
            fi
        done
        export HOME=/tmp
        drop="setpriv --reuid=$HOST_UID --regid=$HOST_GID --clear-groups"
        exec $drop env HOME=/tmp cargo "$@"
    ' -- "$@"
