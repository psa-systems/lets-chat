#!/usr/bin/env bash
# Run lets-chat-server in a detached Docker container with port 8080 published.
# Names the container so it can be stopped later via dev/server-down.
set -euo pipefail

# Compute build metadata on the host (the rust:slim container has no git).
# build.rs reads these env vars first and falls back to "unknown" otherwise.
GIT_HASH=$(git rev-parse --short=12 HEAD 2>/dev/null || echo unknown)
GIT_VERSION=$(git describe --tags --always --dirty 2>/dev/null || echo "$GIT_HASH")
BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)

docker rm --force lets-chat-rewrite-server >/dev/null 2>&1 || true
docker run --rm --detach --init \
    --name lets-chat-rewrite-server \
    --user "$(id -u):$(id -g)" \
    -p "127.0.0.1:${HOST_PORT:-8080}:8080" \
    -v "$PWD:/work" \
    -w /work \
    -v lets-chat-rewrite-cargo-registry:/usr/local/cargo/registry \
    -v lets-chat-rewrite-cargo-git:/usr/local/cargo/git \
    -v lets-chat-rewrite-target:/cargo-target \
    -v lets-chat-rewrite-data:/data \
    -e CARGO_HOME=/usr/local/cargo \
    -e CARGO_TARGET_DIR=/cargo-target \
    -e LETS_CHAT_DATA_DIR=/data \
    -e BIND_ADDR=0.0.0.0:8080 \
    -e RUST_LOG=lets_chat=debug \
    -e "GIT_HASH=$GIT_HASH" \
    -e "GIT_VERSION=$GIT_VERSION" \
    -e "BUILD_DATE=$BUILD_DATE" \
    rust:1.88-slim-bookworm \
    cargo run "$@"
echo "Server container started: lets-chat-rewrite-server"
echo "Tail logs: docker logs --follow lets-chat-rewrite-server"
echo "Stop:      ./dev/server-down"
