#!/usr/bin/env bash
# Wrapper: runs cargo inside the shared org rust-builder image since the host
# has no Rust toolchain. The image (`ghcr.io/niceguyit/rust-builder-glibc`)
# bakes in Rust 1.94 + rustfmt + clippy + every native system library every
# repo under ~/projects/a8n-run/ has needed (gtk, webkit, soup, sqlite, ssl,
# fontconfig, libgit2, X/Wayland, etc), so the local check matches the CI
# build environment one-for-one. Image tag must stay aligned with
# `ci-build/Dockerfile.web` and the desktop Dockerfiles.
#
# Volumes cache the cargo registry, the git checkout cache, and the build
# target directory across invocations so rebuilds are incremental. The three
# volume names are namespaced by the invoking uid (LC-773): two builds started
# by different host users on the same machine (e.g. an agent workdir under uid
# 1000 and the Forgejo runner under uid 10002) each get their own volumes, so a
# concurrent build cannot chown the shared target out from under the other
# mid-compile and fail it with "Permission denied (os error 13)" under
# /cargo-target. The cost is per uid: the first build a given uid runs after
# this change rebuilds its dependency graph once (expected, not a regression).
# The rustup volume is intentionally NOT shared with the image's baked rustup
# state - the image already provides rustfmt and clippy, so this wrapper
# does not install components and does not need a persistent rustup home.
set -euo pipefail

# Compute build metadata on the host (the rust:slim container has no git).
# build.rs reads these env vars first and falls back to "unknown" otherwise.
GIT_HASH=$(git rev-parse --short=12 HEAD 2>/dev/null || echo unknown)
GIT_VERSION=$(git describe --tags --always --dirty 2>/dev/null || echo "$GIT_HASH")
BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)

HOST_UID=$(id -u)
HOST_GID=$(id -g)

# LC-773: namespace the cache/target volumes by the invoking uid so a build by
# another host user on the same machine mounts different volumes and cannot
# corrupt this one's cargo state. dev/cargo-desktop MUST use the same
# expression, so a same-uid desktop build still shares these compiled deps.
vol_prefix="lets-chat-rewrite-${HOST_UID}"

# The container starts as root so it can chown the named volumes to the host
# user on FIRST use: Docker initialises a new named volume with the image-path
# ownership (root:root in rust:slim), which would block cargo from writing the
# registry/target paths once we drop privileges. Since LC-773 the volumes are
# per-uid, so this is no longer a cross-user handover - it only repairs a
# freshly-created root-owned volume. The loop is idempotent: a volume already
# owned by the host user skips the recursive walk. After ownership is sorted we
# use setpriv to exec cargo as the host user so Cargo.lock and any other files
# written into the /work bind mount land with the right ownership on the host.
docker run --rm --init \
    -v "$PWD:/work" \
    -w /work \
    -v "${vol_prefix}-cargo-registry:/usr/local/cargo/registry" \
    -v "${vol_prefix}-cargo-git:/usr/local/cargo/git" \
    -v "${vol_prefix}-target:/cargo-target" \
    -e CARGO_HOME=/usr/local/cargo \
    -e CARGO_TARGET_DIR=/cargo-target \
    -e "HOST_UID=$HOST_UID" \
    -e "HOST_GID=$HOST_GID" \
    -e "GIT_HASH=$GIT_HASH" \
    -e "GIT_VERSION=$GIT_VERSION" \
    -e "BUILD_DATE=$BUILD_DATE" \
    -e "FIXTURE_WRITE=${FIXTURE_WRITE:-}" \
    ghcr.io/niceguyit/rust-builder-glibc:v1.0.1-rust1.94-trixie \
    bash -c '
        set -euo pipefail
        for d in /usr/local/cargo/registry /usr/local/cargo/git /cargo-target; do
            if [ "$(stat -c %u "$d")" != "$HOST_UID" ]; then
                chown -R "$HOST_UID:$HOST_GID" "$d"
            fi
        done
        # HOME defaults to /root (mode 700) when setpriv drops to a uid with no
        # passwd entry. Point it at /tmp so libgit2 (invoked by cargo) does not
        # hit permission-denied reading /root/.gitconfig when scanning the repo.
        export HOME=/tmp
        drop="setpriv --reuid=$HOST_UID --regid=$HOST_GID --clear-groups"
        exec $drop env HOME=/tmp cargo "$@"
    ' -- "$@"
