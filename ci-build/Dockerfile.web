# syntax=docker/dockerfile:1.6

# Multi-stage build:
#   1. chef    - cargo-chef installer (planner + cacher share this base).
#   2. planner - generate recipe.json describing the dependency graph.
#   3. cacher  - cook dependencies for lets-chat-server (cached layer).
#   4. css     - run Tailwind via Bun to produce tailwind-built.css.
#   5. builder - compile the release server binary using cached deps.
#   6. runtime - minimal Debian image with binary, assets, and migrations.
#
# BUILD_MODE selects the cargo feature set and binary:
#   - standalone (default): self-hosted with built-in registration/login/admin.
#   - saas:                 external auth via parent app cookie; no register/admin.

ARG BUILD_MODE=standalone
ARG GIT_HASH=unknown
ARG GIT_VERSION=unknown
ARG BUILD_DATE=unknown

FROM ghcr.io/niceguyit/rust-builder-glibc:v1.0.1-rust1.94-trixie AS chef

# Cap concurrent rustc / build-script processes. The desktop and OCI
# builds run in parallel on the same CI runner; without a cap each
# container reads the host's nproc and queues that many cargo
# workers, oversubscribing the runner. nproc/2 lets the two builds
# share the host without stepping on each other. Overridable via
# `--build-arg CARGO_BUILD_JOBS=N` for ad-hoc local builds.
ARG CARGO_BUILD_JOBS=2
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
RUN echo "build parallelism: CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS} (host nproc=$(nproc))"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS cacher
ARG BUILD_MODE
COPY --from=planner /app/recipe.json recipe.json
RUN set -eux; \
    if [ "$BUILD_MODE" = "saas" ]; then \
      cargo chef cook --release --no-default-features --features saas --recipe-path recipe.json -p lets-chat-server; \
    else \
      cargo chef cook --release --features standalone --recipe-path recipe.json -p lets-chat-server; \
    fi

# css - Tailwind build plus first-party asset minification (LC-781 F8). The Bun
# image already carries a minifier (used for tailwind-built.css); this stage
# extends it to the hand-written `main.css` and every served first-party script,
# writing each back to its own name so the template references and the service
# worker precache list need no edit. Excluded: `sw.js` (compiled into the binary
# via include_str! from the ORIGINAL source, not served from this dir) and the
# `*.test.js` node-test files (not served, and they require('node:test')).
# `vendor/*` is already minified and lives in a subdir the flat glob skips.
#
# LC-812: `--format=cjs` is required, not cosmetic. `bun build` defaults to ESM
# output, so any file exposing `module.exports` (media-constraints.js and
# mute-state.js expose it for `node --test`) is emitted with a top-level
# `export default ...`. Those files load as CLASSIC scripts in base.html, where
# `export` is a SyntaxError - the script never runs, its `window.LetsChat*`
# global is never set, and the first capture path crashes on join. CJS output
# keeps the original eager IIFE (global still assigned) and the guarded
# `module.exports` (skipped in the browser), with no `export`. The trailing grep
# is a build-time backstop: fail loudly if a served script ever ships a
# top-level `export`/`import` statement again rather than shipping a broken join
# to prod. The regex anchors on a statement boundary so a `/export?...` URL
# string in a script body is not a false positive.
FROM oven/bun:1 AS css
WORKDIR /app/server
COPY server/package.json server/bun.lock server/tailwind.config.js ./
COPY server/assets ./assets
COPY server/templates ./templates
RUN bun install --frozen-lockfile \
    && bun run tailwindcss --input assets/tailwind.css --output assets/tailwind-built.css --minify \
    && (cd assets \
        && bun build main.css --minify --outdir . \
        && bun build $(ls *.js | grep -vE 'test\.js$|^sw\.js$') --minify --format=cjs --outdir . \
        && if grep -lE '(^|[;}])(export[ {*]|import[ {*"'"'"'])' $(ls *.js | grep -vE 'test\.js$|^sw\.js$'); then \
             echo 'ERROR: a served script contains a top-level export/import statement (LC-812); classic <script> load will SyntaxError' >&2; \
             exit 1; \
           fi)

FROM chef AS builder
ARG BUILD_MODE
ARG GIT_HASH
ARG GIT_VERSION
ARG BUILD_DATE
ENV GIT_HASH=${GIT_HASH} \
    GIT_VERSION=${GIT_VERSION} \
    BUILD_DATE=${BUILD_DATE}
COPY . .
COPY --from=cacher /app/target /app/target-cooked
COPY --from=cacher /usr/local/cargo /usr/local/cargo
# LC-781 F8: pull the whole minified assets tree from the css stage (minified
# main.css + first-party *.js + tailwind-built.css, with sw.js and images
# passed through unchanged), overwriting the originals `COPY . .` brought in.
# This must land before `cargo build` below so the release binary embeds the
# original (unminified) sw.js via include_str! - which this stage left alone -
# and ServeDir serves the minified rest from disk at runtime.
COPY --from=css /app/server/assets server/assets
# A BuildKit cache mount keeps the release target dir warm across `--build`
# runs so a source edit recompiles only the changed crates instead of the
# whole app crate every time (the dominant cost in local `just run`
# iteration). The mount shadows the cargo-chef-cooked target COPY'd above,
# so on a cold cache (every CI build; the first local build) we seed it from
# /app/target-cooked with `cp -a` to preserve mtimes and keep cargo's
# dependency fingerprints valid; warm rebuilds skip the copy. The id is keyed
# by BUILD_MODE so the standalone and saas feature sets get separate caches
# and never relink against each other. The cargo registry stays on the COPY
# above (already layer-cached via the cacher stage), so it is intentionally
# NOT cache-mounted here - a registry cache mount would shadow that COPY and
# force a cold re-download.
RUN --mount=type=cache,target=/app/target,id=lc-target-${BUILD_MODE},sharing=locked \
    set -eux; \
    if [ ! -d target/release ]; then cp -a /app/target-cooked/. target/; fi; \
    if [ "$BUILD_MODE" = "saas" ]; then \
      cargo build --release --no-default-features --features saas -p lets-chat-server; \
      cp target/release/lets-chat-saas /app/lets-chat; \
    else \
      cargo build --release --features standalone -p lets-chat-server; \
      cp target/release/lets-chat /app/lets-chat; \
    fi

FROM debian:trixie-slim AS runtime
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl tzdata \
    && rm -rf /var/lib/apt/lists/*

# Non-root runtime user; /data is volume-mounted and must be writable.
RUN useradd --create-home --uid 1000 appuser \
    && mkdir -p /app/server /data \
    && chown -R appuser:appuser /app /data

WORKDIR /app
COPY --from=builder --chown=appuser:appuser /app/lets-chat /usr/local/bin/lets-chat
COPY --from=builder --chown=appuser:appuser /app/server/assets /app/server/assets
COPY --from=builder --chown=appuser:appuser /app/server/migrations /app/server/migrations

USER appuser

ENV LETS_CHAT_DATA_DIR=/data \
    BIND_ADDR=0.0.0.0:8080 \
    RUST_LOG=lets_chat=info

LABEL org.opencontainers.image.source=https://dev.a8n.run/a8n-tools/lets-chat
LABEL org.opencontainers.image.description="lets-chat"

EXPOSE 8080

# LC-581: probe the dedicated liveness endpoint, not /login. /healthz touches no
# DB or SSO, so it reports healthy the instant the process is listening and can
# never false-negative on a dependency hiccup. /login rendered a full template
# and pulled in the auth path, so it conflated "process up" with "login works".
# start-period is 30s (was 5s) to cover a legitimately slow cold boot: startup
# runs migrations, the General-enclave backfill, SSO discovery + JWKS, and the
# syntect warm sequentially before it ever binds, and a healthy-but-slow boot
# must not be culled. A crash-loop restarts faster than this and resets the
# timer, so real failures still surface.
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD curl --fail --silent http://localhost:8080/healthz >/dev/null || exit 1

ENTRYPOINT ["lets-chat"]
