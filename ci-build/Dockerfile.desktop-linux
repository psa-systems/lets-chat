# Build stage for Dioxus desktop application (Linux/glibc + WebKitGTK)
FROM rust:1.93-slim-trixie AS builder

WORKDIR /build

# Install build dependencies:
#   - WebKitGTK and GTK for the Dioxus desktop renderer (wry)
#   - Bun for Tailwind CSS generation
#   - Standard build tools
RUN apt-get update && apt-get install --yes --no-install-recommends \
    curl pkg-config libssl-dev unzip lld build-essential \
    libwebkit2gtk-4.1-dev libxdo-dev libayatana-appindicator3-dev librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Bun
RUN curl --fail --location --silent --show-error https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

# Install cargo-binstall, then use it to fetch pre-built dioxus-cli
RUN curl --location --silent --show-error https://github.com/cargo-bins/cargo-binstall/releases/latest/download/cargo-binstall-x86_64-unknown-linux-gnu.tgz \
    | tar --extract --gzip --directory /usr/local/cargo/bin
RUN cargo binstall dioxus-cli@0.7.3 --no-confirm

# --- Dependency caching (server-side only) ---
COPY Cargo.toml Cargo.lock ./
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release \
    && rm -rf src target/release/deps/lets_chat*

# --- Full build with dioxus ---
COPY . .

# Build Tailwind CSS
RUN bun install --frozen-lockfile && bun run tailwindcss --input assets/tailwind.css --output assets/tailwind-built.css --minify

# Build desktop app
RUN dx build --release --platform desktop
