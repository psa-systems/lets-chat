# syntax=docker/dockerfile:1.6

# Build the lets-chat-desktop binary for Linux x86_64.
#
# The desktop crate is a Tauri 2 webview wrapper (Wry under the hood) that
# links against system GTK 3 / WebKit2GTK 4.1 / libsoup 3 libraries, so the
# build image installs those plus the usual native build deps. The runtime
# artifact is the single binary at /build/target/release/lets-chat-desktop,
# which the CI workflow extracts via `docker create` + `docker cp`.

FROM ghcr.io/niceguyit/rust-builder-glibc:v1.0.1-rust1.94-trixie AS builder
ARG GIT_HASH=unknown
ARG GIT_VERSION=unknown
ARG BUILD_DATE=unknown
ENV GIT_HASH=${GIT_HASH} \
    GIT_VERSION=${GIT_VERSION} \
    BUILD_DATE=${BUILD_DATE}

# Cargo parallelism comes from the CI runner via --build-arg CARGO_BUILD_JOBS;
# `default` is cargo's own keyword for all CPUs, for ad-hoc local builds.
ARG CARGO_BUILD_JOBS=default
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
RUN echo "build parallelism: CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}"

WORKDIR /build
COPY . .

RUN cargo build --release -p lets-chat-desktop
