# syntax=docker/dockerfile:1.29

# Cross-compile the lets-chat-desktop binary to Windows x86_64.
#
# Uses the rust-builder-glibc-windows base image, which already provides the
# mingw-w64 toolchain (gcc-mingw-w64-x86-64, windres) and the
# x86_64-pc-windows-gnu Rust target. Tauri 2's Windows backend (Wry under
# the hood) talks to WebView2 via Windows-RT bindings (the webview2-com
# crate); tauri-build also embeds a Windows resource through `embed-resource`,
# which shells out to `x86_64-w64-mingw32-windres`. No extra build-time
# libraries beyond those provided by the base image are required. The runtime
# artifacts are the binary at
# /build/target/x86_64-pc-windows-gnu/release/lets-chat-desktop.exe and, beside
# it, WebView2Loader.dll (LC-1176 - the mingw target links the loader
# dynamically, so the DLL must travel with the exe). The CI workflow extracts
# both via `docker create` + `docker cp`.

FROM ghcr.io/niceguyit/rust-builder-glibc-windows:v1.2.0-rust1.98.1-trixie AS builder
ARG GIT_HASH=unknown
ARG GIT_VERSION=unknown
ARG BUILD_DATE=unknown
# LC-594 / LC-831: the update coordinates compiled into the binary. These are
# the two names desktop/src/update.rs reads through option_env!; the release
# pipeline passes the same registry and repository it pushes the artifacts to,
# so the client cannot poll a location the release never writes. Empty here so
# a local build keeps the in-source fallback.
ARG LETS_CHAT_UPDATE_REGISTRY_URL=
ARG LETS_CHAT_UPDATE_REPOSITORY=
# LC-1163: default server a released installer opens on first launch (read by
# config.rs via option_env!). Empty keeps the localhost fallback for local
# builds; publish-release.yml injects the production URL.
ARG LETS_CHAT_DEFAULT_SERVER_URL=
ENV GIT_HASH=${GIT_HASH} \
    GIT_VERSION=${GIT_VERSION} \
    BUILD_DATE=${BUILD_DATE} \
    LETS_CHAT_UPDATE_REGISTRY_URL=${LETS_CHAT_UPDATE_REGISTRY_URL} \
    LETS_CHAT_UPDATE_REPOSITORY=${LETS_CHAT_UPDATE_REPOSITORY} \
    LETS_CHAT_DEFAULT_SERVER_URL=${LETS_CHAT_DEFAULT_SERVER_URL}

# Cargo parallelism comes from the CI runner via --build-arg CARGO_BUILD_JOBS;
# `default` is cargo's own keyword for all CPUs, for ad-hoc local builds.
ARG CARGO_BUILD_JOBS=default
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
RUN echo "build parallelism: CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}"

# Point the gnu target at the mingw linker so rustc invokes the correct
# cross-linker without per-developer `~/.cargo/config.toml` plumbing.
ENV CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER=x86_64-w64-mingw32-gcc

WORKDIR /build
COPY . .

RUN cargo build --release -p lets-chat-desktop --target x86_64-pc-windows-gnu

# LC-1176: the x86_64-pc-windows-gnu (mingw) target links WebView2Loader
# DYNAMICALLY - the static WebView2LoaderStatic.lib the webview2-com-sys crate
# ships is MSVC-only - so the runtime exe needs WebView2Loader.dll next to it or
# it dies at launch with "WebView2Loader.dll was not found". The crate stages the
# correct-arch DLL under its build OUT_DIR; copy it beside the exe so the release
# workflow extracts both. Fail the build if it is not where we expect rather than
# silently ship an exe that cannot run (the bug this fixes).
RUN set -eux; \
    dll="$(find /build/target/x86_64-pc-windows-gnu/release/build -name WebView2Loader.dll | head -n1)"; \
    test -n "$dll"; \
    cp "$dll" /build/target/x86_64-pc-windows-gnu/release/WebView2Loader.dll; \
    ls -l /build/target/x86_64-pc-windows-gnu/release/WebView2Loader.dll
