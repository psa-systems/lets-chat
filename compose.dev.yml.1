---
# Developer Docker Compose: builds via the same multi-stage Dockerfile as
# production, then attaches the running container to the shared Traefik
# network so it is reachable at https://${USER}-chat.a8n.run.
name: chat-${USER}

services:

  dev-lets-chat-app:
    build:
      context: .
      dockerfile: ci-build/Dockerfile.web
      args:
        BUILD_MODE: ${BUILD_MODE:-standalone}
        GIT_HASH: ${GIT_HASH:-unknown}
        GIT_VERSION: ${GIT_VERSION:-unknown}
        BUILD_DATE: ${BUILD_DATE:-unknown}
    container_name: dev-lets-chat-app-${USER}
    restart: unless-stopped
    environment:
      RUST_LOG: lets_chat=debug
      LETS_CHAT_DATA_DIR: /data
      LETS_CHAT_SECRET_KEY: sghsgG8vVnvr9gddWwrL03
      BIND_ADDR: 0.0.0.0:8080
      # SMTP relay. This file is the committed TEMPLATE; the real config
      # lives in compose.dev.yml (kept out of git via skip-worktree).
      # Copy this file to compose.dev.yml, then uncomment + fill in all
      # six LETS_CHAT_SMTP_* variables plus LETS_CHAT_BASE_URL with your
      # relay credentials. Leaving any blank disables outbound mail and
      # the /forgot + /reset routes return 404. See .env.standalone for
      # variable documentation. LETS_CHAT_SMTP_TLS must be one of
      # "tls" / "starttls" / "none"; port 465 implicit TLS uses "tls".
      # LETS_CHAT_BASE_URL: "https://${USER}-chat.a8n.run"
      # LETS_CHAT_SMTP_HOST: ""
      # LETS_CHAT_SMTP_PORT: ""
      # LETS_CHAT_SMTP_TLS: ""
      # LETS_CHAT_SMTP_USERNAME: ""
      # LETS_CHAT_SMTP_PASSWORD: ""
      # LETS_CHAT_SMTP_FROM: ""
    volumes:
      - dev-lets-chat-data:/data
    networks:
      - dev-lets-chat-private
      - network-traefik-public
    # Sequence form (not mapping) so Compose interpolates ${USER} in the
    # router/service name segments. Compose v2 does NOT substitute variables
    # inside YAML mapping keys, only in values; sequence items are values
    # end-to-end, so the whole "key=value" string gets interpolated.
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=network-traefik-public"
      - "traefik.http.routers.chat-${USER}.rule=Host(`${USER}-chat.a8n.run`)"
      - "traefik.http.routers.chat-${USER}.service=chat-${USER}@docker"
      - "traefik.http.routers.chat-${USER}.entrypoints=web-secure"
      - "traefik.http.routers.chat-${USER}.tls.certresolver=cert-cloudflare"
      - "traefik.http.services.chat-${USER}.loadbalancer.server.port=8080"

volumes:
  dev-lets-chat-data:
    name: dev-lets-chat-data-${USER}

networks:
  dev-lets-chat-private:
    name: dev-lets-chat-private-${USER}
  network-traefik-public:
    external: true
