# =============================================================================
# lets-chat - Standalone Mode
# =============================================================================
# Build:  cargo build --release --features standalone
# Docker: docker build --build-arg BUILD_MODE=standalone -t lets-chat:standalone .
#
# Authentication is Bunyip SSO only (LC-22): sign-in goes through a Bunyip
# OIDC provider ("Sign in with Bunyip"). There is no local registration,
# username/password login, password reset, or 2FA. Sessions are still stored
# in auth.db as random tokens; the first user to sign in is promoted to Admin.
#
# NOTE: this file is a reference template. The local dev tooling
# (`just dev-web-local`, `compose.dev-web-local.yml`) does NOT load it. Copy
# these values into the secrets mechanism appropriate for your
# deployment (Docker `--env-file`, a secrets manager, Kubernetes
# Secret, etc.) and replace every placeholder before deploying.

###############################################################################
# ---- Bunyip SSO (REQUIRED) ----
###############################################################################

# All four are mandatory; the server refuses to start without them (no flag,
# no local-auth fallback). Discovery + JWKS are fetched from the issuer at
# startup and must succeed. The client must be registered on the OP as a
# confidential client_secret_basic client whose redirect_uris includes the
# REDIRECT_URI below ({base}/auth/bunyip/callback).
LETS_CHAT_BUNYIP_SSO_ISSUER=https://your-op.example.com
LETS_CHAT_BUNYIP_SSO_CLIENT_ID=replace-me
LETS_CHAT_BUNYIP_SSO_CLIENT_SECRET=replace-me
LETS_CHAT_BUNYIP_SSO_REDIRECT_URI=https://chat.example.com/auth/bunyip/callback

# DEV ONLY. Set to 1/true to accept invalid TLS certs for the SSO HTTP client
# (a dev OP behind a self-signed cert). reqwest's rustls uses bundled webpki
# roots that ignore the system CA store, so there is no env/mount-only remedy.
# NEVER set in production: it disables issuer TLS authentication.
# LETS_CHAT_BUNYIP_SSO_INSECURE_TLS=1

# DEV ONLY (DEV-300). Fleet-wide bootstrap-admin variable, `email:password`
# (menkent, bunyip and eform read the same name). While the deployment has no
# admin, a DEBUG build seeds one unlinked admin row holding that verified
# email; the first sign-in with the same email at the OP adopts it. The
# password half is accepted for format compatibility and never stored - there
# is no local password auth (LC-22). A RELEASE build, which is all this repo
# ships, refuses to seed and logs an error, so this can never mint an admin on
# a real deployment. The OP must also claim `bunyip_role: admin` for that
# identity (LC-413), or the adopted account is demoted back to `user`.
# SETUP_DEFAULT_ADMIN=admin@example.com:admin1234

###############################################################################
# ---- Standalone-Only Configuration ----
###############################################################################

# Encrypts at-rest secrets:
#   - VAPID private key (Web Push notifications)
#   - the sealed IMAP password for email ingress
# Unset or empty disables those features. The Bunyip SSO client secret is NOT
# encrypted here (it is read from the env var above).
# Any non-empty string works; the server SHA-256-hashes it to derive
# a 32-byte AES-256-GCM key, so what matters is entropy.
# Generate with: openssl rand -base64 32
LETS_CHAT_SECRET_KEY=change-me-in-production

# LC-864: deployment environment label. Shown as a badge in the app shell and on
# the sign-in / first-entry / invitation pages so users can tell which
# environment they are in and which one their account is provisioned against.
# Unset, empty, or "production"/"prod" (any case) shows nothing (production is
# the default). Any other value (e.g. staging, dev) is displayed verbatim.
# LETS_CHAT_ENVIRONMENT=staging

# SMTP relay for outbound mail (the hourly digest and per-mention / per-DM
# notification emails). All non-credential variables below must be set
# together; leaving any of them unset disables outbound mail entirely. (There
# is no password-reset mail: auth is handled by the Bunyip OP.)
#
# LETS_CHAT_SMTP_USERNAME / LETS_CHAT_SMTP_PASSWORD may both be left unset
# for relays that accept unauthenticated submission (e.g. a localhost-only
# sendmail).
#
# LETS_CHAT_SMTP_TLS values:
#   tls       implicit TLS from connect (commonly port 465)
#   starttls  cleartext handshake then upgrade (commonly port 587)
#   none      cleartext throughout - localhost relays only
# Boolean aliases (true/yes/1 -> tls, false/no/0 -> none) are also accepted.
# LETS_CHAT_SMTP_HOST=smtp.example.com
# LETS_CHAT_SMTP_PORT=587
# LETS_CHAT_SMTP_TLS=starttls
# LETS_CHAT_SMTP_USERNAME=relay-user
# LETS_CHAT_SMTP_PASSWORD=relay-pass
# LETS_CHAT_SMTP_FROM=no-reply@example.com

# Absolute base URL used to build links inside outbound mail (digest and
# mention/DM notifications) and to anchor the SSO redirect. Should match the
# host in LETS_CHAT_BUNYIP_SSO_REDIRECT_URI.
# Defaults to http://localhost:8080 (only useful for local development).
# LETS_CHAT_BASE_URL=https://chat.example.com

###############################################################################
# ---- Shared Configuration ----
###############################################################################

# Bind address (optional, defaults to 0.0.0.0:8080)
# BIND_ADDR=0.0.0.0:8080

# Directory for SQLite .db files (optional, defaults to /data)
# LETS_CHAT_DATA_DIR=/data

# Log level filter (optional, defaults to lets_chat=info)
# RUST_LOG=lets_chat=info

###############################################################################
# ---- Call transcription (optional) ----
###############################################################################

# Voice/video calls (1:1 and enclave voice channels) can be transcribed. By
# default each participant's browser transcribes its own mic with the Web Speech
# API and no server config is needed. To instead run transcription SERVER-SIDE
# (browser-agnostic - works in Firefox/Safari - and keeps audio off third-party
# clouds), point LETS_CHAT_STT_URL at an OpenAI-compatible
# /v1/audio/transcriptions endpoint (whisper.cpp server, faster-whisper,
# LocalAI, ...). Unset = the in-browser engine.
# _API_KEY (optional) is sent as a bearer token; _MODEL defaults to whisper-1.
# The endpoint is operator-trusted and NOT SSRF-filtered, so it may be a
# localhost/internal service; never point it at an untrusted host.
# LETS_CHAT_STT_URL=http://127.0.0.1:8090/v1/audio/transcriptions
# LETS_CHAT_STT_API_KEY=
# LETS_CHAT_STT_MODEL=whisper-1
# LC-591: optional glossary/style hint sent as the STT `prompt` (biases spelling
# of names and jargon). A single global string; per-room glossaries are not
# supported. Example: a comma-separated list of product/person names.
# LETS_CHAT_STT_PROMPT=
# LC-593: provider wire shape. `openai` (default) speaks the OpenAI
# /v1/audio/transcriptions multipart shape; `deepgram` speaks Deepgram's
# prerecorded /v1/listen (raw body, `Authorization: Token`, JSON word timings).
# For deepgram, point _URL at https://api.deepgram.com/v1/listen (or a
# self-hosted instance), set _API_KEY, and _MODEL to a Deepgram model (e.g.
# nova-2). _PROMPT is OpenAI-only and ignored by deepgram.
# LETS_CHAT_STT_PROVIDER=openai
# LC-590: request timeout in seconds, replacing the 10s shared outbound-HTTP
# ceiling for STT only (a long clip on a CPU-bound engine routinely exceeds it,
# and used to be silently dropped). Scaled up by the recorded clip length where
# known, capped at 300s (the recorder's own maximum). Transient failures
# (connect, timeout, 5xx, 429) are retried up to 3 times with backoff; a 4xx is
# never retried. A voice message whose transcription still fails is marked
# failed and shows the author a Retry control.
# LETS_CHAT_STT_TIMEOUT_SECS=60
# LC-592: cost/load control. _SCOPE selects which stored attachments are
# transcribed: both (default), voice (voice notes only), clips (video clips
# only, the expensive path), or none (call captions still work; this gates
# stored attachments only). _WORKERS caps concurrent transcriptions, which is
# what protects a CPU-bound self-hosted engine. _RATE_GLOBAL and _RATE_ROOM cap
# submissions per minute server-wide and per room, which is what bounds the bill
# on a metered engine (concurrency alone does not: two workers can bill all day).
# Over-cap voice messages are marked failed and offer their author a Retry;
# over-cap call clips are dropped and surface the caption warning.
# LETS_CHAT_STT_SCOPE=both
# LETS_CHAT_STT_WORKERS=2
# LETS_CHAT_STT_RATE_GLOBAL=30
# LETS_CHAT_STT_RATE_ROOM=10

# Optional AI summary + action items for SAVED call transcripts. Point
# LETS_CHAT_LLM_URL at an OpenAI-compatible /v1/chat/completions endpoint
# (Ollama, llama.cpp server, vLLM, LocalAI, ...) to show a "Summarize" action on
# the transcript page; the generated summary is cached. Unset = the action is
# hidden. _API_KEY (optional) bearer token; _MODEL defaults to gpt-4o-mini. Same
# operator-trusted, NOT-SSRF-filtered posture as STT (may be localhost/internal).
# LC-679: setting this only makes the LLM AVAILABLE; the whole AI surface stays
# OFF until an admin flips the runtime flag in Admin > Settings > "AI features"
# (defaulted off, no restart to toggle). When on, AI is exposed only to site
# admins, enclave owners/admins and room moderators - not to every user.
# LETS_CHAT_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
# LETS_CHAT_LLM_API_KEY=
# LETS_CHAT_LLM_MODEL=gpt-4o-mini

# Optional semantic search + "Find related" messages (LC-549). This is a SEPARATE
# service from the chat LLM above - point LETS_CHAT_EMBEDDINGS_URL at an
# OpenAI-compatible /v1/embeddings endpoint (Ollama, llama.cpp, LocalAI, ...) and
# pull an embedding model (e.g. `ollama pull nomic-embed-text`). Unset = the
# "Find related" menu item is hidden and semantic search degrades to keyword
# (FTS). _API_KEY (optional) bearer token; _MODEL defaults to text-embedding-3-small
# (set it to the model you pulled, e.g. nomic-embed-text). Same runtime AI flag +
# role gate as the LLM (LC-679): configuring this only makes embeddings AVAILABLE.
# LETS_CHAT_EMBEDDINGS_URL=http://127.0.0.1:11434/v1/embeddings
# LETS_CHAT_EMBEDDINGS_API_KEY=
# LETS_CHAT_EMBEDDINGS_MODEL=nomic-embed-text

# Optional image alt-text auto-draft (LC-667). Point LETS_CHAT_VISION_URL at an
# OpenAI-vision-compatible /v1/chat/completions endpoint served by a MULTIMODAL
# model (llava, llama3.2-vision, ... - the text LLM above cannot see images) to
# add an "Auto-draft" button to the image alt-text editor. Separate from the LLM
# because vision models are heavier and often a different endpoint. Unset = the
# button is hidden. _MODEL defaults to llava. The image is sent only to this
# operator endpoint (never leaves the box); same trusted, non-SSRF-filtered
# posture as the LLM/STT endpoints.
# LETS_CHAT_VISION_URL=http://127.0.0.1:11434/v1/chat/completions
# LETS_CHAT_VISION_API_KEY=
# LETS_CHAT_VISION_MODEL=llava

# Optional AI moderation triage (LC-670). When set truthy AND an LLM is
# configured, each posted message is classified in the background and clear
# spam / harassment / inappropriate cases are FLAGGED to the site-admin report
# queue (/admin/reports) for human review - never auto-deleted or hidden.
# Content only reaches your own LLM. Unset/off = no auto-triage.
# LETS_CHAT_AI_MODERATION=1

# Optional personal weekly recap (LC-671). When set truthy AND an LLM is
# configured, each active user is DMed once a week a short, AI-written recap of
# their week (messages sent, kudos received) from the assistant bot. Personal
# (only the recipient sees it); users with a quiet week are skipped. Unset/off =
# no weekly recap.
# LETS_CHAT_WEEKLY_RECAP=1

# Optional GIF picker (Giphy). Set LETS_CHAT_GIPHY_API_KEY to a Giphy API key to
# show the composer GIF button: the server proxies search to Giphy and re-hosts
# the chosen GIF same-origin (never hotlinked into messages). Unset = the GIF
# button is hidden. _RATING (optional) is g / pg / pg-13 / r, default pg-13.
# LETS_CHAT_GIPHY_API_KEY=
# LETS_CHAT_GIPHY_RATING=pg-13
