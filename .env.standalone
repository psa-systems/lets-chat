# =============================================================================
# lets-chat - Standalone Mode
# =============================================================================
# Build:  cargo build --release --features standalone
# Docker: docker build --build-arg BUILD_MODE=standalone -t lets-chat:standalone .
#
# Authentication is Bunyip SSO only (LC-22): sign-in goes through a Bunyip
# OIDC provider ("Sign in with Bunyip"). There is no local registration,
# username/password login, password reset, or 2FA. Sessions are still stored
# in auth.db as random tokens; the first user to sign in is promoted to Admin.
#
# NOTE: this file is a reference template. The local dev tooling
# (`just dev-web-local`, `compose.dev.yml`) does NOT load it. Copy
# these values into the secrets mechanism appropriate for your
# deployment (Docker `--env-file`, a secrets manager, Kubernetes
# Secret, etc.) and replace every placeholder before deploying.

###############################################################################
# ---- Bunyip SSO (REQUIRED) ----
###############################################################################

# All four are mandatory; the server refuses to start without them (no flag,
# no local-auth fallback). Discovery + JWKS are fetched from the issuer at
# startup and must succeed. The client must be registered on the OP as a
# confidential client_secret_basic client whose redirect_uris includes the
# REDIRECT_URI below ({base}/auth/bunyip/callback).
LETS_CHAT_BUNYIP_SSO_ISSUER=https://your-op.example.com
LETS_CHAT_BUNYIP_SSO_CLIENT_ID=replace-me
LETS_CHAT_BUNYIP_SSO_CLIENT_SECRET=replace-me
LETS_CHAT_BUNYIP_SSO_REDIRECT_URI=https://chat.example.com/auth/bunyip/callback

# DEV ONLY. Set to 1/true to accept invalid TLS certs for the SSO HTTP client
# (a dev OP behind a self-signed cert). reqwest's rustls uses bundled webpki
# roots that ignore the system CA store, so there is no env/mount-only remedy.
# NEVER set in production: it disables issuer TLS authentication.
# LETS_CHAT_BUNYIP_SSO_INSECURE_TLS=1

###############################################################################
# ---- Standalone-Only Configuration ----
###############################################################################

# Encrypts at-rest secrets:
#   - VAPID private key (Web Push notifications)
#   - the sealed IMAP password for email ingress
# Unset or empty disables those features. The Bunyip SSO client secret is NOT
# encrypted here (it is read from the env var above).
# Any non-empty string works; the server SHA-256-hashes it to derive
# a 32-byte AES-256-GCM key, so what matters is entropy.
# Generate with: openssl rand -base64 32
LETS_CHAT_SECRET_KEY=change-me-in-production

# SMTP relay for outbound mail (the hourly digest and per-mention / per-DM
# notification emails). All non-credential variables below must be set
# together; leaving any of them unset disables outbound mail entirely. (There
# is no password-reset mail: auth is handled by the Bunyip OP.)
#
# LETS_CHAT_SMTP_USERNAME / LETS_CHAT_SMTP_PASSWORD may both be left unset
# for relays that accept unauthenticated submission (e.g. a localhost-only
# sendmail).
#
# LETS_CHAT_SMTP_TLS values:
#   tls       implicit TLS from connect (commonly port 465)
#   starttls  cleartext handshake then upgrade (commonly port 587)
#   none      cleartext throughout - localhost relays only
# Boolean aliases (true/yes/1 -> tls, false/no/0 -> none) are also accepted.
# LETS_CHAT_SMTP_HOST=smtp.example.com
# LETS_CHAT_SMTP_PORT=587
# LETS_CHAT_SMTP_TLS=starttls
# LETS_CHAT_SMTP_USERNAME=relay-user
# LETS_CHAT_SMTP_PASSWORD=relay-pass
# LETS_CHAT_SMTP_FROM=no-reply@example.com

# Absolute base URL used to build links inside outbound mail (digest and
# mention/DM notifications) and to anchor the SSO redirect. Should match the
# host in LETS_CHAT_BUNYIP_SSO_REDIRECT_URI.
# Defaults to http://localhost:8080 (only useful for local development).
# LETS_CHAT_BASE_URL=https://chat.example.com

###############################################################################
# ---- Shared Configuration ----
###############################################################################

# Bind address (optional, defaults to 0.0.0.0:8080)
# BIND_ADDR=0.0.0.0:8080

# Directory for SQLite .db files (optional, defaults to /data)
# LETS_CHAT_DATA_DIR=/data

# Log level filter (optional, defaults to lets_chat=info)
# RUST_LOG=lets_chat=info
