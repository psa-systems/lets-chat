# =============================================================================
# lets-chat - Standalone Mode
# =============================================================================
# Build:  cargo build --release --features standalone
# Docker: docker build --build-arg BUILD_MODE=standalone -t lets-chat:standalone .
#
# Standalone mode ships built-in registration, login, and admin pages.
# Sessions are stored in auth.db; passwords are Argon2id-hashed.
#
# NOTE: this file is a reference template. The local dev tooling
# (`just dev-web-local`, `compose.dev.yml`) does NOT load it. Copy
# these values into the secrets mechanism appropriate for your
# deployment (Docker `--env-file`, a secrets manager, Kubernetes
# Secret, etc.) and replace every placeholder before deploying.

###############################################################################
# ---- Standalone-Only Configuration ----
###############################################################################

# Encrypts at-rest secrets:
#   - TOTP secrets (two-factor authentication)
#   - VAPID private key (Web Push notifications)
# Unset or empty disables both features.
# Any non-empty string works; the server SHA-256-hashes it to derive
# a 32-byte AES-256-GCM key, so what matters is entropy.
# Generate with: openssl rand -base64 32
LETS_CHAT_SECRET_KEY=change-me-in-production

# SMTP relay used to send password reset emails. All six variables below
# must be set together; leaving any of them unset disables outbound mail
# entirely, which makes the /forgot and /reset/{token} routes return 404
# and the "Forgot password?" link on the login page a dead end.
#
# SMTP_USERNAME / SMTP_PASSWORD may both be left unset for relays that
# accept unauthenticated submission (e.g. a localhost-only sendmail).
#
# SMTP_TLS values:
#   tls       implicit TLS from connect (commonly port 465)
#   starttls  cleartext handshake then upgrade (commonly port 587)
#   none      cleartext throughout - localhost relays only
# Boolean aliases (true/yes/1 -> tls, false/no/0 -> none) are also accepted.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USERNAME=relay-user
# SMTP_PASSWORD=relay-pass
# SMTP_FROM=no-reply@example.com

# Absolute base URL used to build links inside outbound mail.
# Required for password reset emails to point at a publicly-resolvable host.
# Defaults to http://localhost:8080 (only useful for local development).
# LETS_CHAT_BASE_URL=https://chat.example.com

###############################################################################
# ---- SSO (OIDC) ----
###############################################################################

# Optional: seed an OIDC SSO provider on first boot. When all three are set,
# the startup path inserts a row into auth.db's sso_providers under the slug
# "default" and enables it; subsequent boots ignore the env vars (admin UI
# edits at /admin/sso survive restarts). LETS_CHAT_SECRET_KEY must also be
# set - the client secret is AES-GCM encrypted in the column. Register the
# client on the IdP side first (mokosh-server: `just register-lets-chat-client`).
# Full design: docs/lets-chat/sso/.
# LETS_CHAT_SSO_ISSUER=https://idp.example.com
# LETS_CHAT_SSO_CLIENT_ID=00000000-0000-0000-0000-000000000000
# LETS_CHAT_SSO_CLIENT_SECRET=paste-the-printed-secret-here

# Optional: allow the seeded provider to auto-provision fresh local users
# from claims (subject, email, preferred_username, name) on first sign-in.
# Off by default; the unauthorized page renders for unknown identities.
# Per-provider override available from /admin/sso once seeded.
# LETS_CHAT_SSO_AUTOPROVISION=false

# Optional: hard-disable the password sign-in path entirely. POST /login,
# /register, /forgot, /reset/:token, /settings/password all 404. Existing
# password_hash rows stay; flip back to false to resume. Typically paired
# with at least one enabled SSO provider so the deployment isn't a brick.
# LETS_CHAT_LOCAL_LOGIN_DISABLED=false

###############################################################################
# ---- Shared Configuration ----
###############################################################################

# Bind address (optional, defaults to 0.0.0.0:8080)
# BIND_ADDR=0.0.0.0:8080

# Directory for SQLite .db files (optional, defaults to /data)
# LETS_CHAT_DATA_DIR=/data

# Log level filter (optional, defaults to lets_chat=info)
# RUST_LOG=lets_chat=info
